@startmindmap
* Container trust boundaries
** EKA-18 local dev stack
*** gebaut: Quick Start -> dev Compose
*** gebaut: db 127.0.0.1:5432
*** gebaut: redis 127.0.0.1:6379
*** gebaut: api service DNS db/redis
*** gebaut: host localhost tools
*** gebaut: focused regression
** EKA-13 production stack
*** monitor
**** gebaut: Docker SDK restart path
**** gebaut: AUTO_RECOVERY_T2 + client allowlist
*** docker-proxy
**** offen: latest -> released tag + manifest digest
**** risk: CONTAINERS=1 + POST=1
**** risk: shared net_ekklesia, no proxy auth
**** risk: host Docker socket
*** neighbours
**** offen separate: Ollama latest
**** offen separate: dashboard/monitor non-root
@endmindmap

@startuml
skinparam componentStyle rectangle
package "EKA-18 dev (built)" {
  component "Quick Start" as QUICK
  component "Dev Compose" as DEV
  component "Host tools" as HOSTTOOLS
  database "PostgreSQL\n127.0.0.1:5432" as DEVDB
  component "Redis\n127.0.0.1:6379" as DEVREDIS
  QUICK --> DEV
  HOSTTOOLS --> DEVDB
  HOSTTOOLS --> DEVREDIS
  DEV --> DEVDB : internal DNS db
  DEV --> DEVREDIS : internal DNS redis
}

package "EKA-13 production (open)" {
  component "Monitor\nDocker SDK" as MON
  component "docker-proxy\nlatest, CONTAINERS=1, POST=1" as PROXY
  component "Official GHCR\nrelease tag + digest" as GHCR
  database "Host Docker daemon" as DOCKER
  cloud "net_ekklesia peers" as PEERS
  MON --> PROXY : tcp://docker-proxy:2375
  PEERS --> PROXY : no proxy auth
  PROXY --> DOCKER : mounted docker.sock
  GHCR ..> PROXY : next provenance fix
}
@enduml
