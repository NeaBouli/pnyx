@startmindmap
* Container trust boundaries
** EKA-18 local dev stack
*** gebaut: Quick Start -> dev Compose
*** gebaut: db 127.0.0.1:5432
*** gebaut: redis 127.0.0.1:6379
*** gebaut: api service DNS db/redis
*** gebaut: host localhost tools
*** gebaut: focused regression
** EKA-13 production stack
*** monitor
**** gebaut: Docker SDK restart source path
**** selected: production AUTO_RECOVERY_T2=false
*** docker-proxy
**** selected: v0.4.2 + manifest digest
**** selected: CONTAINERS/EVENTS/PING/VERSION=0 + POST=0
**** selected: dedicated internal network, monitor only
**** risk: host Docker socket
**** result: no Docker API namespace enabled while T2 is off
*** neighbours
**** offen separate: Ollama latest
**** offen separate: dashboard/monitor non-root
@endmindmap

@startuml
skinparam componentStyle rectangle
package "EKA-18 dev (built)" {
  component "Quick Start" as QUICK
  component "Dev Compose" as DEV
  component "Host tools" as HOSTTOOLS
  database "PostgreSQL\n127.0.0.1:5432" as DEVDB
  component "Redis\n127.0.0.1:6379" as DEVREDIS
  QUICK --> DEV
  HOSTTOOLS --> DEVDB
  HOSTTOOLS --> DEVREDIS
  DEV --> DEVDB : internal DNS db
  DEV --> DEVREDIS : internal DNS redis
}

package "EKA-13 production (selected fix)" {
  component "Monitor\nDocker SDK" as MON
  component "docker-proxy\nv0.4.2@digest\nGET namespaces=0, POST=0" as PROXY
  component "Official GHCR\nv0.4.2 + digest" as GHCR
  database "Host Docker daemon" as DOCKER
  cloud "net_ekklesia peers" as PEERS
  rectangle "internal monitor-proxy network" as PRIVATE
  MON --> PRIVATE : only consumer
  PRIVATE --> PROXY : tcp://docker-proxy:2375
  PEERS ..> PROXY : no route after fix
  PROXY --> DOCKER : mounted docker.sock
  GHCR ..> PROXY : selected provenance fix
}
@enduml
