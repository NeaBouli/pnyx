@startuml
title Sentry event capture: exception/request to transport

participant "FastAPI / Starlette" as WEB
participant "_sentry_init_options" as POLICY
participant "Sentry SDK\nevent construction" as SDK
participant "_before_send_filter" as FILTER
participant "Sentry transport" as TRANSPORT

POLICY -> SDK : init integrations, sampling, hooks (H2)
WEB -> SDK : exception / transaction + request context (H1)
SDK -> SDK : build stack frames; implicit local capture (H3)
SDK -> SDK : derive request metadata; implicit body capture (H4)
SDK -> FILTER : constructed event (H5)
FILTER -> FILTER : remove env/cookies/query; redact known keys
FILTER -> TRANSPORT : filtered envelope (H6)

note over POLICY,SDK
Required capture boundary:
include_local_variables = false
max_request_body_size = never
end note

note over FILTER
Retained as defense in depth for
headers, query strings, extras and
integration-supplied event data.
end note
@enduml

@startuml faq-lang-main-path
title faq.html: langBtn onclick -> toggleLang -> querySelectorAll("[data-el]")

actor Nutzer
participant "FAQ Markup\n(faq.html)" as Markup
participant "FAQ Sprachwechsel\n(toggleLang)" as Toggle
participant "FAQ A11y-Adapter\n(r3-faq-accessibility.js)" as A11y

== Laden ==
Markup -> Markup : <html lang="el" data-lang="el">
Markup -> A11y : script defer
A11y -> Markup : .faq-q role/tabindex/aria-expanded/aria-controls

== Klick EN ==
Nutzer -> Markup : click #langBtn
Markup -> Toggle : toggleLang()
Toggle -> Toggle : currentLang = "en"
Toggle -> Markup : #langBtn.textContent = "ΕΛ"
Toggle -> Markup : querySelectorAll("[data-el]")
loop je [data-el] Element
  Toggle -> Markup : el.innerHTML = data-en
end
note over Toggle, Markup
  offen (#365): document.documentElement.lang bleibt "el",
  data-lang bleibt "el". Kein Code, daher keine Kante.
end note
@enduml
